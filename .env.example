# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel:
# Project → Settings → Environment Variables (Production e Preview). Depois faça um novo deploy.

# Google Analytics 4 — ID da métrica (Admin → Fluxos de dados → Web). Formato G-XXXXXXXXXX
VITE_GA4_ID=

# Meta Pixel (opcional) — Gerenciador de Eventos → Fontes de dados. Só números.
VITE_META_PIXEL_ID=
